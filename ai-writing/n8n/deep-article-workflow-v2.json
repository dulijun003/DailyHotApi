    {
      "parameters": {
        "jsCode": "// 解析 302.ai 异步结果，兼容多种返回结构。\n// 输出：状态 = done / pending / failed / timeout\nconst MAX = Number($('配置').first().json['最大轮询次数']) || 45;\nconst attempt = $runIndex + 1;\n\nconst res = $input.first().json ?? {};\nconst data = (res.data && typeof res.data === 'object') ? res.data : res;\nconst status = String(data.status ?? res.status ?? '').toLowerCase();\nconst outputs = Array.isArray(data.output) ? data.output : [];\n\n// 取最后一条 assistant 消息的正文，并收集引用链接\nconst messages = outputs.filter(o => o && o.type === 'message' && (o.role ?? 'assistant') === 'assistant');\nconst last = messages[messages.length - 1];\nlet report = '';\nconst citations = new Map();\nfor (const c of (last?.content ?? [])) {\n  if (typeof c === 'string') { report += c; continue; }\n  if (typeof c?.text === 'string') report += c.text;\n  for (const a of (c?.annotations ?? [])) {\n    if (a?.url && !citations.has(a.url)) citations.set(a.url, a.title || a.url);\n  }\n}\nreport = report.trim();\nconst searches = outputs.filter(o => o?.type === 'web_search_call').length;\n\nconst FAILED = ['failed', 'error', 'cancelled', 'canceled', 'expired'];\nlet state;\nif (report.length > 200 && !['queued', 'in_progress', 'pending', 'running'].includes(status)) state = 'done';\nelse if (FAILED.includes(status)) state = 'failed';\nelse if (['completed', 'succeeded', 'success'].includes(status)) state = report ? 'done' : 'failed';\nelse if (attempt >= MAX) state = 'timeout';\nelse state = 'pending';\n\nconst sources = [...citations].map(([url, title], i) => `[${i + 1}] ${title} - ${url}`).join('\\n');\n\nreturn [{\n  json: {\n    状态: state,\n    原始状态: status || '(无 status 字段)',\n    轮询次数: attempt,\n    搜索次数: searches,\n    研究报告: report,\n    引用来源: sources,\n    错误信息: state === 'failed' || state === 'timeout'\n      ? (res.error?.message ?? JSON.stringify(data.error ?? data.incomplete_details ?? res, null, 2)).slice(0, 3000)\n      : '',\n  },\n}];"
      },
