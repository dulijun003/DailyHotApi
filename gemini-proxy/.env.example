# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，不要把真实 Cookie 提交到仓库

# 调用本服务时使用的密钥（自己随便设一串，客户端里填同样的值）
# 生成方式：openssl rand -hex 24
API_KEY=change-me

# 本机端口
PORT=8000

# ===== 账号 1 =====
# 无痕窗口登录 https://gemini.google.com → F12 → Application → Cookies → https://gemini.google.com
ACCOUNT1_SECURE_1PSID=
ACCOUNT1_SECURE_1PSIDTS=
# 可选：该账号的出口代理，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7891
# 注意：容器内访问宿主机代理请用 host.docker.internal 代替 127.0.0.1
ACCOUNT1_PROXY=

# temporary（推荐，不保存到网页版历史）或 normal
CHAT_MODE=temporary
LOG_LEVEL=INFO
